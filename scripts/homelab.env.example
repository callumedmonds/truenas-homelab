# Copy to homelab.env alongside these scripts and fill in your own values.
#
#     cp homelab.env.example homelab.env
#
# homelab.env is gitignored. Drive serials and IP addresses identify one
# specific machine — a serial is the identifier used for warranty and RMA
# lookups, and it correlates a repo with any other artifact quoting the same
# drive — so they stay out of version control.
#
# Scripts read this file via homelab_env.py (Python) or by sourcing it (shell).
# Every value is quoted so the file stays valid POSIX shell -- an unquoted
# value containing a space or a bracket makes `. homelab.env` a syntax error.
# Anything already exported in the environment wins over the file, so a systemd
# EnvironmentFile or a container env var can override any key here.

# --- addresses ------------------------------------------------------------
# The examples use RFC 5737 documentation ranges. Replace with your own.
NAS_IP="192.0.2.10"
VM_IP="192.0.2.20"
GATEWAY_IP="192.0.2.1"
LAN_CIDR="192.0.2.0/24"
PLEX_HOST="192.0.2.20:32400"

# --- drives ---------------------------------------------------------------
# serial:pool pairs, separated by ';' (a label may contain a comma).
# Find yours with:
#     lsblk -o NAME,SERIAL,MODEL,SIZE
COLD_SERIALS="SERIAL0001:cold01;SERIAL0002:cold02;SERIAL0003:cold03;SERIAL0004:cold04"

# serial:label pairs for thermal_loadtest.py, same ';' separator — the drives to actually load.
TEST_SERIALS="SERIAL0005:Cloud36 (IronWolf, the hot one);SERIAL0006:Cloud36;SERIAL0007:Cloud36;SERIAL0008:Cloud36;SERIAL0009:Cloud36;SERIAL0010:Cloud36;SERIAL0003:cold03"

# The single drive make_cold04.py and rescue_ntfs.py operate on.
RESCUE_SERIAL="SERIAL0004"
